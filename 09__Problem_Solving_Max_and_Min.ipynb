   "source": [
    "inp = input()\n",
    "\n",
    "number = inp.split()\n",
    "\n",
    "a = int(number[0])\n",
    "b = int(number[1])\n",
    "c = int(number[2])\n",
    "\n",
    "max = a\n",
    "min = a\n",
    "\n",
    "#Minimum Number\n",
    "if b < min :\n",
    "    min = b\n",
    "if c < min:\n",
    "    min = c\n",
    "\n",
    " #Maximum Number\n",
    "\n",
    "if b > max:\n",
    "        max = b\n",
    "if c > max:\n",
    "        max = c\n",
    "\n",
    "print(min, max)\n"
   ]
  }
